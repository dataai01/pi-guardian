# Pi Guardian configuration
TEMP_MAX=80
DISK_PCT_MAX=90

# services to monitor (space-separated)
SERVICES=ssh tailscaled

# dashboard
DASH_BIND=0.0.0.0
DASH_PORT=8080

# notifications (optional)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# backups
BACKUP_LABEL=PI_BACKUP
BACKUP_MOUNT=/mnt/backup
PI_GUARDIAN_STATE_DIR=/var/lib/pi-guardian
